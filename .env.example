# aetherPet 环境变量模板
# 复制为 .env 并按需填写；本地开发默认值可直接用于 Docker MySQL

# ============== 数据库（MySQL 8.x） ==============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aetherpet
DB_PASS=***
DB_NAME=aetherpet
# 连接池大小（默认 10）
DB_POOL_SIZE=10
# 是否自动执行 migration（启动时）；开发=true，生产建议单独跑 scripts/run-migrations.ts
DB_AUTO_MIGRATE=true

# ============== 认证 / 安全 ==============
# token 有效期（毫秒），默认 30 天 = 30 * 24 * 60 * 60 * 1000 = 2592000000
TOKEN_TTL_MS=2592000000
# 验证码有效期（毫秒），默认 10 分钟
VERIFICATION_CODE_TTL_MS=600000
# 同邮箱节流窗口（毫秒）：默认 5 分钟
VERIFICATION_WINDOW_MS=300000
# 同邮箱节流窗口内最大发送次数：默认 3
VERIFICATION_MAX_PER_WINDOW=3
# IP 全局限流窗口（毫秒）：默认 5 分钟
IP_RATE_WINDOW_MS=300000
# IP 全局限流窗口内最大请求数：默认 30
IP_RATE_MAX_PER_WINDOW=30
# /api/auth/verify 独立 IP 节流窗口（默认 5 分钟，防 6 位码枚举）
VERIFY_IP_RATE_WINDOW_MS=300000
# /api/auth/verify 独立 IP 节流窗口内最大请求数
VERIFY_IP_RATE_MAX_PER_WINDOW=30
# /api/auth/verify 单 email 窗口内最大失败次数（内存计数，进程重启后清零）
VERIFY_MAX_ATTEMPTS_PER_EMAIL=10

# ============== SMTP（中心自治邮件） ==============
# 自托管中心各自配置；官方中心用官方 SMTP
# 支持 SES / Gmail / Resend / 自建 SMTP / QQ/163 等
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_F…ple.com
# true=TLS (465) / false=STARTTLS (587)
SMTP_SECURE=false
# 开发模式：true 时邮件仅 console.log，不发真邮件（本地无 SMTP 也能跑）
SMTP_DRY_RUN=true

# ============== 中心身份（hub-autonomous email 身份标识） ==============
HUB_ID=local
HUB_DISPLAY_NAME=aetherPet Local
HUB_ADMIN_EMAIL=admin@example.com
HUB_PRIVACY_URL=https://example.com/privacy
# 中心域名（用于公告、跨中心溯源；MVP 未强校验）
HUB_DOMAIN=

# ============== 素材包 ==============
# 素材包目录（相对于 process.cwd()）
ASSET_PACKS_DIR=./src/assets/packs
# 默认素材包名
DEFAULT_PACK=default

# ============== 运行时 ==============
NODE_ENV=development
# 是否信任上游反代注入的 X-Forwarded-For / X-Real-Ip
# 默认 false：直接取 socket.remoteAddress，拒绝客户端伪造（P1-001）
# 部署在可信反代后（且已配置 proxy_set_header）才置 true
TRUST_PROXY=false
# 反代信任跳数（从右往左）
PROXY_TRUST_HOPS=1
# 是否开启开发端点白名单（Round 2 P2-013）
# 默认 false：生产模式下 /api/pet/generate-event 拒绝请求（返回 403）
# 置 true 可开启白名单，供内网演示 / staging 手动触发事件调试
# 警告：本项仅影响 /api/pet/generate-event，不会放宽其他端点
ENABLE_DEV_ENDPOINTS=false
