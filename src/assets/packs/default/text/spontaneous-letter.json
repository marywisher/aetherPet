{
  "type": "spontaneous_letter",
  "slots": {
    "title": { "mode": "fixed", "default": "{pet_name} 的一封信" },
    "body": {
      "mode": "template",
      "variants": {
        "daily": [
          "今天没什么事，就想写封信。",
          "{recall_line}",
          "没什么特别的，就是想你了。"
        ],
        "poetic": [
          "昨夜 {pet_name} 做了一个梦，{recall_line}",
          "月亮从窗前过的时候，{pet_name} 想写点什么。"
        ]
      },
      "poetic_ratio": 0.10
    },
    "sign_off": { "mode": "template", "variants": ["— {pet_name}", "—— {pet_name}"] }
  },
  "assets": {
    "letter_bg": "images/letter-bg.svg",
    "icon": "images/icons/letter.svg"
  },
  "highlight": { "memory_refs": true, "anchor_style": "underline" },
  "recall_required": ["pet_name", "time_anchor"],
  "recall_min_count": 0
}
