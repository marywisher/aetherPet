# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
.next/
out/
build/
dist/
*.tsbuildinfo
# playwright 报告
test-results/
playwright-report/

# ---------- 环境变量 · 隐私（绝不提交） ----------
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# ---------- 运行时日志（按日生成，隐私可含用户IP等） ----------
logs/
*.log
npm-debug.log*

# ---------- 数据库/备份（含用户数据） ----------
data/
backups/
*.db
*.sql.gz
*.dump

# ---------- 本地素材包/覆盖物 ----------
src/assets/packs/*/local/
!src/assets/packs/**/manifest.json

# ---------- 系统/编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp